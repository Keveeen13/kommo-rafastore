# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Chave secreta: usada SOMENTE no servidor (webhook / sync). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Kommo ---
# subdomínio: https://SEUSUBDOMINIO.kommo.com
KOMMO_SUBDOMAIN=seusubdominio
# Token de longa duração (Kommo > Configurações > Integrações > sua integração privada > Chaves e escopos)
KOMMO_ACCESS_TOKEN=

# --- Segredos do sistema (invente strings longas e aleatórias) ---
# Vai na URL do webhook: /api/webhooks/kommo?secret=ESTE_VALOR
WEBHOOK_SECRET=
# Protege /api/sync e /api/fields (header Authorization: Bearer ESTE_VALOR)
SYNC_SECRET=
